# Supabase (separate project from Royal Stroje, EU region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode during demo)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional e-mail
RESEND_API_KEY=
EMAIL_FROM="Royal Shop <objednavky@example.sk>"
ADMIN_NOTIFY_EMAIL=

# Vercel Cron authorization
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AG náradie feeds (the addresses carry our access token: never commit the real ones)
# cennik_export.xml: stock + prices, read by the daily cron /api/cron/ag-sklad and scripts/ag-catalog.py
AG_PRICE_FEED_URL=
# sklad_karty_export.xml: names, texts, photos; read only by scripts/ag-catalog.py
AG_CARDS_FEED_URL=
